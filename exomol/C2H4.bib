@article{72PaLexx.C2H4,
Author = {Parson, J. M. and Lee, Y. T.},
Title = {{Crossed Molecular Beam Study of F+C$_2$H$_4$, C$_2$D$_4$}},
Journal = JCP,
Year = {1972},
Volume = {56},
Pages = {4658-4666},
Abstract = {Crossed molecular beam experiments on F+C2H4, C2D4 have been performed with a mass spectrometric universal detector. Angular distributions of both substitution and abstraction reaction products were measured. The substitution reaction to form C2H3F (C2D3F) appears to proceed via a long-lived complex, yet the recoil energy of the products has a broad distribution peaking at about half of the energy available. Experimental results for the substitution reaction are compared with the predictions of the RRKM theory of unimolecular decomposition. The discrepencies between them and inadequacies of the theory are discussed. Highly vibrationally excited DF was produced through the abstraction reaction of F+C2D4. DF formed in the forward direction of F motion is primarily in v′=4. The formation of DF(v′=4) also suggests, from the conservation of total energy, that the internal excitation of the other reaction product C2D3 should be very small.},
DOI = {10.1063/1.1677917}
}

