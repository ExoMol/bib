@article{19Ch.C2H4,
Author = {Chapovsky, P. L.},
Title = {{Laser detection of nuclear spin isomers of ethylene molecules}},
Journal = {Quantum Electron.},
Year = {2019},
Volume = {49},
Pages = {623-627},
Abstract = {We report the making of a double-beam laser spectrometer to measure absorption spectra in the ν 5 + ν 9 combination vibrational band of ethylene in the region of λ = 1.6 μm. The spectrometer is used to find a portion of the spectrum that has well-resolved absorption lines of all four nuclear spin isomers of ethylene molecules. The rotational quantum numbers of these absorption lines and the nuclear spin isomers of ethylene molecules responsible for them are identified.},
DOI = {10.1070/qel16918}
}

@article{19ChHaPi.C2H4,
Author = {Chen, Z. and H\"{a}nsch, T. W. and Picqu\'{e}, N.},
Title = {{Mid-infrared feed-forward dual-comb spectroscopy}},
Journal = PNAS,
Year = {2019},
Volume = {116},
Pages = {3454-3459},
Abstract = {Each molecule leaves characteristic absorptions, which enable one to unambiguously identify and quantify it, and to understand its structure and dynamics. Such fingerprints, strong in the mid-infrared region of the electromagnetic spectrum, can be accessed by measuring the intensity of light transmitted through a medium as a function of its frequency. Here, we describe a spectrometer for mid-infrared spectroscopy based on two frequency comb generators, light sources emitting narrow evenly spaced laser lines over a broad spectral bandwidth. Our instrument without moving parts simultaneously measures broad high-resolution spectra with calibration of the frequency scale directly to an atomic clock and precise spectral line shapes. These features are obtained from the experimental data without any need for corrective processing.},
DOI = {10.1073/pnas.1819082116}
}

