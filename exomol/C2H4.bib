@article{26EvHuDe.C2H4,
Author = {Evans, J. V. and Huynh, A. H. and Demko, A. R.},
Title = {{Laser absorption spectroscopy measurements of ethylene production during hydroxyl-terminated polybutadiene pyrolysis}},
Journal = {Meas. Sci. Technol.},
Year = {2026},
Volume = {37},
Pages = {435501},
Abstract = {Ethylene (C 2 H 4 ) is a prevalent pyrolysis product of hydroxyl-terminated polybutadiene (HTPB), a widely used binder in solid rocket propellants. This study quantifies the production of ethylene during the pyrolysis of two HTPB variants, R-45 M and R-45HTLO, using tunable diode laser absorption spectroscopy (TDLAS) in order to more completely characterize the pyrolysis products of HTPB and understand its pyrolysis mechanisms. A low ethylene detection limit diagnostic targeting high line-strength transitions of ethylene at approximately 949 cm − 1 which was recently demonstrated in the literature, was employed to measure mole fractions during the controlled heating of HTPB in an inert nitrogen atmosphere for the first time. The experimental configuration included an optically accessible closed pressure vessel equipped with a thermistor-heated aluminum brick, instrumented to measure temperature and pressure in addition to the TDLAS measurements. Results indicated that ethylene production begins at brick temperatures of approximately 600 K, with peak mole fractions reaching 0.04 and an average value of 0.018. The study demonstrated that using a spectral data analysis method in which two absorbance lines near 949.64 cm − 1 were used in the ethylene mole fraction calculation improves the reliability of mole fraction calculations compared to an initial spectral data analysis method in which five absorbance lines were fit, but only one line was used for the ethylene mole fraction calculation in the applied ethylene TDLAS diagnostic. These findings provide critical data for refining chemical kinetic models and advancing the understanding of HTPB pyrolysis mechanisms. The developed methodology offers a robust framework for studying pyrolysis products in other hydrocarbon fuels.},
DOI = {10.1088/1361-6501/aeb4dd}
}

@article{26PeLeSu.C2H4,
Author = {Perot, S. and Lecomte, J. and Suas-David, N. and Rutkowski, L. and Rey, M. and Dud\'{a}s, E. and Georges, R.},
Title = {{Analysis of a non-LTE hypersonic spectrum of ethylene between 5880 and 6200 cm$^{-1}$}},
Journal = JCP,
Year = {2026},
Volume = {165},
Pages = {054302},
Abstract = {Hydrocarbons are partly responsible for the opacity of warm Jupiters’ atmospheres in the infrared. Laboratory high-resolution spectroscopic data, including hot band rovibrational transitions, are crucial to model and interpret telescope observations. In this work, a set of six hot bands and 11 cold bands of ethylene (12C2H4) is observed using cavity ringdown spectroscopy between 5880 and 6200 cm−1. The ethylene sample is preheated to 650 and 850 K before being expanded through a Laval nozzle to produce a high Mach number expansion. The rotational temperature drops to ∼12–13 K in the jet, while the vibrational population accumulates in the first excited vibrational state ν10, from which all the observed hot bands originate. The observed transitions are assigned using the lower state combination difference approach; a set of A, B, and C rotational constants, along with the energy of the upper state, is determined using PGOPHER software for the 17 observed vibrational bands. The TheoReTS (Theoretical Reims-Tomsk Spectral data) model, employed to identify the upper vibrational states, will benefit from these newly identified transitions.},
DOI = {10.1063/5.0334949}
}

@article{26HjSiCa.C2H4,
Author = {Hj\"{a}lt\'{e}n, A. and {Silva de Oliveira}, V. and Cao, Y. and Silander, I. and Lehmann, K. K. and Foltynowicz, A.},
Title = {{Optical frequency comb double-resonance spectroscopy of the 9030--9175 cm$^{-1}$ states of ethylene}},
Journal = JCP,
Year = {2026},
Volume = {165},
Pages = {014304},
Abstract = {We use optical–optical double-resonance (OODR) spectroscopy to measure for the first time hot-band transitions of ethylene between states in the 3000 and 9000 cm−1 energy ranges. A 3.2 μm continuous wave (CW) pump is used to populate selected states in the ν9 vibrational mode. The sub-Doppler OODR transitions are then probed with two different cavity-enhanced probes tunable around 1.7 μm: a frequency comb probe that allows for broadband measurements and simultaneous detection of many OODR lines and a CW probe that measures individual lines with higher signal-to-noise ratio and better frequency accuracy. We report center frequencies and relative intensities of 90 ladder-type hot-band transitions from three different states in the ν9 vibrational mode. We exploit combination differences and measurements of polarization-dependent intensity ratios to determine the final state rotational quantum numbers J. Comparison to theoretical predictions from ExoMol allows tentative assignments for 28 transitions. We also report improved line center frequencies for the three pump transitions in the ν9 band. Furthermore, we observe 18 sub-Doppler V-type transitions from the depleted ground state to the 6000 cm−1 region and assign 14 of them using ExoMol and the variational line list of Mraidi et al. [J. Quant. Spectrosc. Radiat. Transfer 310, 108734 (2023)].},
DOI = {10.1063/5.0333268}
}

@article{25DoBeBo.C2H4,
Author = {Dodangodage, R. and Bernath, P. F. and Boone, C. and Lecours, M. and Schmidt, M.},
Title = {{Atmospheric ethylene (C$_2$H$_4$) observations from the Atmospheric Chemistry Experiment Fourier Transform Spectrometer (ACE-FTS)}},
Journal = JQSRT,
Year = {2025},
Volume = {346},
Pages = {109603},
Abstract = {The Atmospheric Chemistry Experiment Fourier Transform Spectrometer (ACE-FTS) utilizes solar occultation to collect high-resolution measurements of atmospheric trace gases as the Sun rises or sets from the satellite's orbiting perspective. This limb-viewing geometry provides unique and vertically resolved observations of Earth's atmosphere. In this study, we present improved retrievals of ethylene (C2H4) from ACE-FTS, offering a comprehensive analysis of its global distribution and temporal variability. The retrievals were enhanced by applying speed-dependent Voigt line shapes to minimize systematic residuals from interfering CO2 lines, enabling more complete use of the available C2H4 spectral information in ACE measurements. The resulting dataset reveals notable enhancements in C2H4 concentrations over high northern latitudes, particularly between 5.5 and 8.5 km altitude. Distinct seasonal variability is observed, with elevated concentrations during winter and reduced levels in summer. Furthermore, a long-term decreasing trend of-0.224 ppt/year is identified over the 2004-2024 period, indicating a gradual decline in atmospheric C2H4 levels.},
DOI = {10.1016/j.jqsrt.2025.109603}
}

