@article{15UlGrBe.C2H4,
Author = {Ulenikov, O. N. and Gromova, O. V. and Bekhtereva, E. S. and Kashirina, N. V. and Bauerecker, S. and Horneman, V.-M.},
Title = {{Precise ro-vibrational analysis of molecular bands forbidden in absorption: The $\nu_8 + \nu_{10}$ band of the $^{12}$C$_2$H$_4$ molecule}},
Journal = JMS,
Year = {2015},
Volume = {313},
