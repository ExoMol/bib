  urldate = {2026-11-23},
  abstract = {We call attention to the great importance of the gas phase reaction ClO + CH               3               O               2               {$\rightarrow$} ClOO + CH               3               O and the heterogeneous reaction HCl + HOCl {$\rightarrow$} Cl               2               + H               2               O on polar stratospheric cloud (PSC) particles. These reactions may accomplish the almost complete conversion of HCl into ClO               x               radicals, thus leading to rapid destruction of ozone.},
